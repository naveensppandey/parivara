# Root Environment Template for PARIVARA Project
# Reference guide for production environment variables

# Frontend (Static Hosting - Vercel/Netlify)
VITE_API_BASE_URL=https://parivara-backend.onrender.com/api

# Backend (Cloud Web Service - Render/Railway)
SPRING_PROFILES_ACTIVE=prod
PORT=8080
