# Backend Environment Variables Template
# Use these environment variables when configuring cloud hosting (Render, Railway, Heroku, AWS, etc.)
# DO NOT commit actual passwords or credentials to Git!

# Spring Active Profile ('dev' for H2 in-memory, 'prod' for PostgreSQL)
SPRING_PROFILES_ACTIVE=prod

# Server Port (Set dynamically by cloud host like Render/Railway)
PORT=8080

# PostgreSQL Database Configuration
DATABASE_URL=jdbc:postgresql://your-db-host.provider.com:5432/parivara_db
DATABASE_USERNAME=your_db_username
DATABASE_PASSWORD=your_secure_db_password

# CORS Configuration (Comma-separated production frontend origins)
CORS_ALLOWED_ORIGINS=https://parivaranatural.com,https://parivara.vercel.app

# Secure Admin Credentials
ADMIN_EMAIL=admin@parivaranatural.com
ADMIN_PASSWORD=your_secure_admin_password_here

# Contact & WhatsApp Numbers
WHATSAPP_NUMBER=919305762044

# SMTP Mail Server Configuration (Future Notifications)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
